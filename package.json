{
  "name": "MicroservicesShop",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo  dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "pnpm": {
    "public-hoist-pattern": [
      "*prisma*",
      "@prisma/*"
    ]
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prettier": "^3.7.4",
    "prisma": "^7.5.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "turbo": "^2.8.10",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
