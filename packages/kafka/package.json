{
  "name": "@repo/kafka",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --watch --dts",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo node_modules",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@types/kafkajs": "^1.9.0",
    "@types/node": "^25.3.3",
    "dotenv": "^17.4.2",
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  }
}
