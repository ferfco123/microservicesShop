{
  "name": "@repo/types",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./dist/auth.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./product": {
      "types": "./dist/product.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cart": {
      "types": "./dist/cart.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./order": {
      "types": "./dist/order.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./payment": {
      "types": "./dist/payment.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@clerk/types": "^4.101.20",
    "@repo/orderdb": "workspace:*",
    "@repo/productdb": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "typescript": "^5.0.0"
  }
}
